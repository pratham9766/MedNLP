{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mednlp:summary-review:v2",
  "title": "MedNLP summary review set",
  "type": "object",
  "required": ["schema_version", "document_id", "source_report", "generated_summary", "review_status", "reviewed", "claims", "critical_omission", "contradiction", "reviewer_id"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "document_id": {"type": "string", "minLength": 1},
    "source_report": {
      "type": "object", "required": ["pages", "passages"],
      "properties": {
        "pages": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["page", "text"], "properties": {"page": {"type": "integer", "minimum": 1}, "text": {"type": "string"}}, "additionalProperties": false}},
        "passages": {"type": "array", "items": {"type": "object", "required": ["page", "start_char", "end_char", "quote"], "properties": {"page": {"type": "integer", "minimum": 1}, "start_char": {"type": "integer", "minimum": 0}, "end_char": {"type": "integer", "minimum": 1}, "quote": {"type": "string", "minLength": 1}}, "additionalProperties": false}}
      }, "additionalProperties": false
    },
    "generated_summary": {"type": "string", "minLength": 1},
    "review_status": {"enum": ["pending", "completed"]},
    "reviewed": {"type": "boolean"},
    "claims": {"type": "array", "items": {"type": "object", "required": ["claim", "supported", "evidence_correct"], "properties": {"claim": {"type": "string", "minLength": 1}, "supported": {"type": ["boolean", "null"]}, "evidence_correct": {"type": ["boolean", "null"]}, "source_page": {"type": ["integer", "null"], "minimum": 1}, "start_char": {"type": ["integer", "null"], "minimum": 0}, "end_char": {"type": ["integer", "null"], "minimum": 1}}, "additionalProperties": false}},
    "critical_omission": {"type": ["boolean", "null"]},
    "contradiction": {"type": ["boolean", "null"]},
    "reviewer_id": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
